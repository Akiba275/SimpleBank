<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The mod stays net6.0 for SMAPI compatibility, while this standalone
         test runner may execute on a newer installed .NET runtime. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\src\SimpleBank.Core\*.cs" />
    <Compile Include="..\tests\SimpleBank.Core.Tests\*.cs" />
  </ItemGroup>
</Project>
